{
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/*",
      "serve": "/index.html",
      "statusCode": 200
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  },
  "headers": [
    {
      "route": "/assets/*.js",
      "headers": [
        {
          "name": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "route": "/assets/*.css",
      "headers": [
        {
          "name": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "route": "/*.html",
      "headers": [
        {
          "name": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "route": "/index.html",
      "headers": [
        {
          "name": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
