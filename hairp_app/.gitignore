# ============================================
# COR-HRP Project .gitignore
# ============================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
eggs/
sdist/
wheels/
*.whl

# ---------- Virtual Environments ----------
venv/
.venv/
env/
ENV/
.python-version

# ---------- IDE / Editor ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-workspace
*.sublime-project

# ---------- Environment & Secrets ----------
.env
.env.*
*.pem
*.key
secrets.json
credentials.json
.git-secret-replacements

# ---------- Only truly oversized data files (100MB+) ----------
*.gpkg

# ---------- Database ----------
*.db
*.sqlite
*.sqlite3

# ---------- Logs & Temp ----------
*.log
logs/
tmp/
.cache/

# ---------- Streamlit ----------
.streamlit/secrets.toml
data:/