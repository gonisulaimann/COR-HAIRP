# ──────────────────────────────────────────────────────────────
# COR-HARP — Git Ignore Configuration
# ──────────────────────────────────────────────────────────────

# ── Operating System Artifacts ──
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ── IDE / Editor Configs ──
.agents/
.claude/
.cursor/
.vscode/
.idea/
*.code-workspace

# ── Secrets & Environment ──
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ── Database Files ──
*.db
*.sqlite
*.sqlite3

# ── Python ──
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# ── Virtual Environments ──
.venv/
venv/
env/
ENV/

# ── Frontend ──
frontend/node_modules/
frontend/dist/

# ── Node (root-level, if any) ──
node_modules/

# ── Deployment Artifacts ──
*.zip
*.tar.gz
deploy-/

# ── Excel Temp Files ──
~$*

# ── Large Binary Files ──
*.gpkg
*.pth
*.onnx

# ── Logs & Cache ──
*.log
logs/
tmp/
.cache/

# ── Legacy ──
hairp_app/venv/
hairp_app/__pycache__/
backend/__pycache__/
.git-secret-replacements
